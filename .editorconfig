root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true

[*.{c,h}]
indent_style = space
indent_size = 2

[{CMakeLists.txt,*.cmake}]
indent_style = space
indent_size = 2

[*.sh]
indent_style = space
indent_size = 2

[{makefile,makefile.*}]
indent_style = tab

[tests/regress/golden/*]
insert_final_newline = unset
